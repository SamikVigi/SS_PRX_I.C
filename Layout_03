from kivy.app import App
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.uix.boxlayout import BoxLayout

class SamuelApp(App):
    def build(self):
        koren = BoxLayout(orientation="vertical")
        koren.add_widget(Label(text="Prihlásenie", font_size="40sp", size_hint=(1, 0.3)))
        koren.add_widget(TextInput(hint_text="Meno", multiline=False))
        koren.add_widget(TextInput(hint_text="Heslo...", password=True))

        koren2 = BoxLayout(orientation="horizontal")
        koren2.add_widget(Button(text="Zrušiť"))
        koren2.add_widget(Button(text="Ok"))

        koren.add_widget(koren2)
        
        return koren

SamuelApp().run()