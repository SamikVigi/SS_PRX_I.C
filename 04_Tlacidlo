from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput


class SamuelApp(App):
    def build(self):
        plocha = BoxLayout(orientation="vertical")

        self.pocet_klikov = 0
        self.vipiš = Label(text = f'Klikni na tlacidlo {self.pocet_klikov} kliknut')
        plocha.add_widget(self.vipiš)
        
        tlacidlo = Button(text="Klik")
        tlacidlo.bind(on_release = self.klik)

        plocha.add_widget(tlacidlo)

        return plocha

    def klik(self, Tlacidlo):
        self.pocet_klikov += 1
        self.vipiš.text = f'klikov {self.pocet_klikov}'

SamuelApp().run()
